{
  "name": "oria-made-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "styles": "node scripts/scope-styles.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:verify": "node scripts/verify-cloudflare.mjs",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/deploy",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "npm run cf:build && npm run cf:deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@oriatheme/colors": "0.2.0",
    "@oriatheme/core": "0.4.0",
    "@oriatheme/editor-core": "0.2.1",
    "@oriatheme/presets": "0.5.1",
    "@oriatheme/react": "0.1.4",
    "@oriatheme/react-editor": "0.1.5",
    "@oriatheme/runtime-dom": "0.2.1",
    "@oriatheme/tailwind": "0.1.0",
    "animejs": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "i18next": "^25.0.0",
    "lucide-react": "^1.43.0",
    "motion": "^13.3.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  }
}
